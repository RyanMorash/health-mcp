{
  "name": "@airbloomer/health-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that stores Health Auto Export and historic Apple Health data and serves it over MCP.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "import:apple": "tsx src/cli/import-apple-health.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.161.0"
  }
}
